{
    "title":  "Auto-AT Run Investigation",
    "description":  "Search session, operation, correlation, trace or run IDs. Expand a log line to inspect safe structured diagnostics.",
    "panels":  [
                   {
                       "id":  1,
                       "gridPos":  {
                                       "y":  12,
                                       "w":  24,
                                       "h":  12,
                                       "x":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "{service=~\"auto-at-.+\"} |= \"$search_id\" | json | line_format \"{{if .operation_status}}OPERATION {{.operation_status}} | stage={{.stage}} | reason={{.outcome_code}} | elapsed={{.duration_ms}}ms | operation={{.operation_id}}{{else}}{{.event}} | {{.message}}{{if .code}} | code={{.code}}{{end}}{{end}}\""
                                       }
                                   ],
                       "type":  "logs",
                       "options":  {
                                       "sortOrder":  "Descending",
                                       "showTime":  true,
                                       "enableLogDetails":  true,
                                       "wrapLogMessage":  true,
                                       "showLabels":  true
                                   },
                       "title":  "Session / correlation / trace / run search"
                   },
                   {
                       "id":  2,
                       "gridPos":  {
                                       "y":  0,
                                       "w":  24,
                                       "h":  12,
                                       "x":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "{service=~\"auto-at-.+\",level=~\"warn|warning|error\"} |= \"$search_id\" | json | event=~\"vision[.].*\" | stage!=\"operation_ack\" | stage!=\"operation_read\" | line_format \"{{if .operation_status}}OPERATION {{.operation_status}} | stage={{.stage}} | reason={{.outcome_code}} | elapsed={{.duration_ms}}ms | operation={{.operation_id}}{{else}}{{.event}} | {{.message}}{{if .code}} | code={{.code}}{{end}}{{end}}\""
                                       }
                                   ],
                       "type":  "logs",
                       "options":  {
                                       "sortOrder":  "Descending",
                                       "showTime":  true,
                                       "enableLogDetails":  true,
                                       "wrapLogMessage":  true,
                                       "showLabels":  true
                                   },
                       "title":  "Vision failures — stage and reason"
                   }
               ],
    "templating":  {
                       "list":  [
                                    {
                                        "label":  "Session / operation / correlation / trace / run ID",
                                        "name":  "search_id",
                                        "type":  "textbox",
                                        "current":  {
                                                        "text":  "",
                                                        "value":  ""
                                                    }
                                    }
                                ]
                   },
    "schemaVersion":  39,
    "refresh":  "10s",
    "time":  {
                 "to":  "now",
                 "from":  "now-1h"
             }
}
