{
  "info": {
    "_postman_id": "ef1b062c-c8b2-4b72-8daf-f5f8bec1c0a2",
    "name": "Auto-AT — Phase 6 product hardening",
    "description": "Import into Postman or Hoppscotch. Run the requests in Basic pipeline order after following README.md. Local authentication is supplied by X-Actor-Id and X-Actor-Roles; production requires the OIDC adapter. Create run saves run_id and correlation_id automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:7000" },
    { "key": "tenant_id", "value": "demo-tenant" },
    { "key": "actor_id", "value": "local-reviewer" },
    { "key": "actor_roles", "value": "tenant_admin" },
    { "key": "project_id", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "test_case_id", "value": "demo-healthz" },
    { "key": "run_id", "value": "REPLACE_AFTER_CREATE_RUN" },
    { "key": "correlation_id", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "proposal_id", "value": "REPLACE_WITH_EXISTING_PROPOSAL_UUID" }
  ],
  "item": [
    {
      "name": "Health and operations",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/healthz" }
        },
        {
          "name": "Metrics scrape",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/metrics" }
        },
        {
          "name": "Operations summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "{{actor_roles}}" }
            ],
            "url": "{{base_url}}/api/v1/operations/summary"
          }
        }
      ]
    },
    {
      "name": "Basic deterministic pipeline",
      "item": [
        {
          "name": "Create run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const run = pm.response.json();",
                  "  pm.collectionVariables.set('run_id', run.id);",
                  "  pm.collectionVariables.set('correlation_id', run.correlation_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "{{actor_roles}}" },
              { "key": "Idempotency-Key", "value": "postman-create-run-{{correlation_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"test_case_id\": \"{{test_case_id}}\",\n  \"revision\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"correlation_id\": \"{{correlation_id}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/runs"
          }
        },
        {
          "name": "Get correlated run",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "{{actor_roles}}" }
            ],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}"
          }
        },
        {
          "name": "Record passed deterministic result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "{{actor_roles}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contract_version\": \"v1\",\n  \"run_id\": \"{{run_id}}\",\n  \"correlation_id\": \"{{correlation_id}}\",\n  \"status\": \"passed\",\n  \"started_at\": \"2026-07-21T10:00:00Z\",\n  \"completed_at\": \"2026-07-21T10:00:01Z\",\n  \"summary\": \"Manual deterministic result.\",\n  \"artifacts\": [],\n  \"runner_metadata\": {}\n}"
            },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/result"
          }
        },
        {
          "name": "List run artifacts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "{{actor_roles}}" }
            ],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/artifacts"
          }
        }
      ]
    },
    {
      "name": "Proposal review",
      "item": [
        {
          "name": "Inspect proposal",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "reviewer" }
            ],
            "url": "{{base_url}}/api/v1/proposals/{{proposal_id}}"
          }
        },
        {
          "name": "Approve proposal (reviewer only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id", "value": "{{actor_id}}" },
              { "key": "X-Actor-Roles", "value": "reviewer" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"approved\": true,\n  \"reason\": \"Reviewed through the Phase 6 collection.\"\n}" },
            "url": "{{base_url}}/api/v1/proposals/{{proposal_id}}/decision"
          }
        }
      ]
    }
  ]
}
