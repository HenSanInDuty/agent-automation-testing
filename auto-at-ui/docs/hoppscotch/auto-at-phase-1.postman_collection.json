{
  "info": {
    "_postman_id": "ef1b062c-c8b2-4b72-8daf-f5f8bec1c0a2",
    "name": "Auto-AT — Phase 1 control plane",
    "description": "Import into Hoppscotch using the Postman importer. Set project_id and test_case_id to records that exist in the local PostgreSQL database before sending Create run. Copy the returned id and correlation_id into run_id and correlation_id for the remaining requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:7000"
    },
    {
      "key": "tenant_id",
      "value": "tenant-a"
    },
    {
      "key": "project_id",
      "value": "REPLACE_WITH_EXISTING_PROJECT_UUID"
    },
    {
      "key": "test_case_id",
      "value": "REPLACE_WITH_EXISTING_TEST_CASE_ID"
    },
    {
      "key": "run_id",
      "value": "REPLACE_WITH_CREATED_RUN_UUID"
    },
    {
      "key": "correlation_id",
      "value": "11111111-1111-4111-8111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/healthz"
          }
        },
        {
          "name": "Platform info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/platform"
          }
        }
      ]
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "Create run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "manual-run-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"test_case_id\": \"{{test_case_id}}\",\n  \"revision\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"correlation_id\": \"{{correlation_id}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/runs"
          }
        },
        {
          "name": "Get run",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}"
          }
        },
        {
          "name": "List artifacts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/artifacts"
          }
        },
        {
          "name": "Record deterministic result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contract_version\": \"v1\",\n  \"run_id\": \"{{run_id}}\",\n  \"correlation_id\": \"{{correlation_id}}\",\n  \"status\": \"passed\",\n  \"started_at\": \"2026-07-21T10:00:00Z\",\n  \"completed_at\": \"2026-07-21T10:00:01Z\",\n  \"summary\": \"Manual deterministic result.\",\n  \"artifacts\": [],\n  \"runner_metadata\": {}\n}"
            },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/result"
          }
        }
      ]
    }
  ]
}
