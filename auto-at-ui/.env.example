# Copy to .env for local development. Never commit .env or a real API key.

# Application
APP_NAME="Auto-AT Control Plane"
ENVIRONMENT=local
PORT=7000
CONTROL_PLANE_PORT=7000

# Optional local Ollama demonstration
OLLAMA_MODEL=ollama:devstral-2
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Governed agent gateway. Keep the credential only in .env/secret storage.
VISION_INTENT_ENCRYPTION_KEY=
VISION_WORKER_SECRET=
# Hugging Face Inference Providers uses an access token with Inference Providers permission.
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
AGENT_PROVIDER=huggingface
AGENT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# OpenRouter remains supported as an environment-only fallback option.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FALLBACK_ENABLED=false
AGENT_FALLBACK_PROVIDER=
AGENT_FALLBACK_MODEL=
AGENT_EVIDENCE_METADATA_ENABLED=true
AGENT_EVIDENCE_REDACTED_TEXT_ENABLED=true
AGENT_EVIDENCE_SCREENSHOTS_ENABLED=false
AGENT_STEP_MAX_TOKENS=8000
AGENT_MAX_STEPS_PER_RUN=2
AGENT_MAX_EVIDENCE_BYTES_PER_STEP=250000
AGENT_MAX_CONCURRENCY=1

# Vision exploration remains disabled until a tenant administrator consents.
# Approved model snapshot: 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0.
# Keep the deployment endpoint pinned to this revision before enabling vision.
VISION_ENABLED=false
VISION_PROVIDER=huggingface
VISION_MODEL=Qwen/Qwen3.8-27B:deepinfra
VISION_RAW_SCREENSHOT_TRANSFER_ACCEPTED=false
VISION_MAX_STEPS=3
VISION_MAX_SCREENSHOT_BYTES=1000000
VISION_MAX_SESSION_SECONDS=120
# This JSON service-account key must be mounted/readable by both control-plane
# and temporal-worker (for example, /run/secrets/google-drive-service-account.json).
# Do not commit the key or put its JSON content in this file.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/run/secrets/google-drive-service-account.json
# My Drive: OAuth credentials for the Google user that owns the target folder.
# OAuth takes precedence over Service Account credentials when all three are set.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_VISION_FOLDER_ID=
# false keeps the uploaded screenshot in Drive and its unlisted anyone-reader
# permission after inference. Enable only with an approved retention policy.
GOOGLE_DRIVE_VISION_DELETE_AFTER_DELIVERY=false
VISION_TEMPORARY_URL_TTL_SECONDS=60
VISION_MAX_COST_USD=0.25
VISION_MAX_REQUESTS_PER_MINUTE=5

# Control-plane services. Docker Compose supplies container hostnames itself;
# these values are convenient when running the Python application directly.
DATABASE_URL=postgresql://auto_at:local-development-only@127.0.0.1:5432/auto_at
REDIS_URL=redis://127.0.0.1:6379/0
# RustFS is the durable S3-compatible evidence store. ARTIFACT_ROOT is staging only.
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=LOCALRUSTFSADMIN
RUSTFS_SECRET_KEY=local-rustfs-development-only
RUSTFS_BUCKET=auto-at-artifacts
RUSTFS_SECURE=false
RUSTFS_REGION=us-east-1
RUSTFS_PATH_STYLE=true
ARTIFACT_UPLOAD_MAX_BYTES=100000000
ARTIFACT_ROOT=/tmp/auto-at-artifacts
PLAYWRIGHT_WORKER_URL=http://127.0.0.1:7100
RUNNER_DISPATCH_ENABLED=false

# PostgreSQL container
POSTGRES_DB=auto_at
POSTGRES_USER=auto_at
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Temporal and durable workflow policy
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=auto-at-local
TEMPORAL_TASK_QUEUE=auto-at-run-dispatch-v1
TEMPORAL_OUTBOX_POLL_INTERVAL_SECONDS=1.0
ARTIFACT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=600
TEMPORAL_RUN_DEADLINE_SECONDS=1200
TEMPORAL_RETRY_INITIAL_INTERVAL_SECONDS=1
TEMPORAL_RETRY_MAXIMUM_INTERVAL_SECONDS=30
TEMPORAL_RETRY_MAXIMUM_ATTEMPTS=3
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_PASSWORD=temporal-local-development-only

# Redis and RustFS container ports/credentials
REDIS_PORT=6379
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local Grafana administrator only; do not expose this stack to product tenants.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-development-only
