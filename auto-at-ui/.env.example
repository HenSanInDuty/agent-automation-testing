# Copy to .env for local development. Never commit .env or a real API key.

# Application
APP_NAME="Auto-AT Control Plane"
ENVIRONMENT=local
PORT=7000
CONTROL_PLANE_PORT=7000

# Optional local Ollama demonstration
OLLAMA_MODEL=ollama:devstral-2
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Governed agent gateway. Keep the credential only in .env/secret storage.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_PROVIDER=openrouter
AGENT_MODEL=openai/gpt-5-mini
AGENT_FALLBACK_ENABLED=false
AGENT_FALLBACK_PROVIDER=
AGENT_FALLBACK_MODEL=
AGENT_EVIDENCE_METADATA_ENABLED=true
AGENT_EVIDENCE_REDACTED_TEXT_ENABLED=true
AGENT_EVIDENCE_SCREENSHOTS_ENABLED=false
AGENT_STEP_MAX_TOKENS=8000
AGENT_MAX_STEPS_PER_RUN=2
AGENT_MAX_EVIDENCE_BYTES_PER_STEP=250000
AGENT_MAX_CONCURRENCY=1

# Control-plane services. Docker Compose supplies container hostnames itself;
# these values are convenient when running the Python application directly.
DATABASE_URL=postgresql://auto_at:local-development-only@127.0.0.1:5432/auto_at
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=auto-at-artifacts
MINIO_SECURE=false
ARTIFACT_ROOT=/tmp/auto-at-artifacts
PLAYWRIGHT_WORKER_URL=http://127.0.0.1:7100
RUNNER_DISPATCH_ENABLED=false

# PostgreSQL container
POSTGRES_DB=auto_at
POSTGRES_USER=auto_at
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Temporal and durable workflow policy
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=auto-at-local
TEMPORAL_TASK_QUEUE=auto-at-run-dispatch-v1
TEMPORAL_OUTBOX_POLL_INTERVAL_SECONDS=1.0
TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=600
TEMPORAL_RUN_DEADLINE_SECONDS=1200
TEMPORAL_RETRY_INITIAL_INTERVAL_SECONDS=1
TEMPORAL_RETRY_MAXIMUM_INTERVAL_SECONDS=30
TEMPORAL_RETRY_MAXIMUM_ATTEMPTS=3
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_PASSWORD=temporal-local-development-only

# Redis and MinIO container ports/credentials
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
